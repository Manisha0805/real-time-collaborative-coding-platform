# Copy to CLIENT/.env (development) or set these in your host's "Environment Variables"
# screen (production). Vite inlines VITE_* values at BUILD time: rebuild after changing them.

# Backend REST API base URL (must end with /api)
VITE_API_URL=https://your-backend.example.com/api
# Socket.IO server origin (same host as the backend, without /api)
VITE_SOCKET_URL=https://your-backend.example.com

# Firebase web app config (Firebase console -> Project settings -> Your apps -> SDK setup).
# These identify your web app and are meant to be public; restrict them with "Authorized domains".
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
