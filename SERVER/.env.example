# ============================================================================
# Real-Time Collaboration - SERVER environment
# Copy to SERVER/.env for local work. In production set these in your host's
# environment-variable settings. NEVER commit the real file.
# ============================================================================

NODE_ENV=development
PORT=5000

# --- Frontend origin(s) allowed by CORS and Socket.IO ------------------------
# Exact origin(s), comma separated, NO trailing slash, e.g.
#   CLIENT_URL=https://myapp.vercel.app,https://www.myapp.com
# Wildcards are supported for preview deployments: https://*.vercel.app
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of the server (Render/Railway/Caddy = 1).
# Needed so rate limiting sees real client IPs. Leave empty to auto-detect (1 in production).
TRUST_PROXY=

# --- Auth ---------------------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d

# --- MySQL (hosted or local) --------------------------------------------------
# Either a single URL ...
# DATABASE_URL=mysql://user:password@host:3306/dbname
# ... or the individual values:
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=real_time_collab
# Hosted MySQL providers usually REQUIRE TLS:
DB_SSL=false
# Set false only if your provider uses a self-signed certificate you cannot supply:
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional provider CA certificate (PEM, or base64 of the PEM):
DB_SSL_CA=

# --- Code execution -----------------------------------------------------------
# docker : sandbox containers on a Docker host (local dev, or a VPS you control)
# judge0 : a separate Judge0 server (use this on Render/Railway/Fly/Heroku-style hosts)
EXECUTION_PROVIDER=docker

# provider=docker -------------------------------------------------------------
# Leave empty to auto-detect (/var/run/docker.sock; Docker Desktop pipe on Windows)
DOCKER_SOCKET_PATH=
# Pull missing runner images in the background on first use (or run: npm run pull-images)
EXEC_AUTO_PULL=true

# provider=judge0 -------------------------------------------------------------
# Public HTTPS URL of YOUR Judge0 server (never localhost in production)
JUDGE0_URL=
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=
# For hosted gateways that need other headers (e.g. RapidAPI), as JSON:
# JUDGE0_EXTRA_HEADERS={"X-RapidAPI-Key":"...","X-RapidAPI-Host":"judge0-ce.p.rapidapi.com"}

# limits (both providers) -------------------------------------------------------
EXEC_RUN_TIMEOUT_SEC=5
EXEC_COMPILE_TIMEOUT_SEC=15
EXEC_MEMORY_MB=256
EXEC_CPUS=1
EXEC_MAX_OUTPUT_BYTES=65536
EXEC_MAX_CODE_BYTES=65536
EXEC_MAX_INPUT_BYTES=65536
EXEC_MAX_CONCURRENT=3
EXEC_MAX_QUEUE=20

# --- Battle Mode --------------------------------------------------------------
BATTLE_DURATION_SECONDS=1800

# --- AI code review (optional) ------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Google sign-in (optional) -------------------------------------------------
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
# EITHER paste the three values (keep \n inside the key):
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# OR provide the whole JSON file base64-encoded (easier on hosting dashboards):
#   base64 -w0 firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_B64=
